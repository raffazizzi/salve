    "@commitlint/config-angular": "^19.8.0",
    "@types/argparse": "^2.0.17",
    "@types/chai": "^5.2.0",
    "@types/file-url": "^2.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.9",
    "@types/node-fetch": "^2.5.7",
    "@types/require-dir": "^1.0.1",
    "@types/temp": "^0.9.4",
    "bluebird": "^3.7.2",
