    "Raff Viglianti <raffaeleviglianti@gmail.com>",
    "Jesse Bethel <keisetsu@gmail.com>",
    "Bennett Buchanan <buchanan.3rd@gmail.com>"
  ],
  "main": "lib/salve/validate.js",
  "browser": "./salve.min.js",
