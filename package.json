  "version": "1.2.1",
  "versionedSources": "lib/salve/validate.ts",
  "keywords": [
    "RelaxNG",
    "Relax NG",
    "rng",
    "XML",
    "validation"
  ],
  "homepage": "https://github.com/raffazizzi/salve",
